ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=asta
POSTGRES_USER=asta
POSTGRES_PASSWORD=changeme

CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- AI Providers ---
# Comma-separated, tried left-to-right. Missing/unconfigured providers are
# skipped automatically on failure — no code changes needed to reorder.
AI_PROVIDER_PRIORITY=ollama,openrouter,cloudflare

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60.0
OLLAMA_MAX_TOKENS=1024
OLLAMA_TEMPERATURE=0.7
OLLAMA_RETRY_COUNT=1
# Routing hints (used to reorder, never to exclude, a provider for a given
# request). CONTEXT_WINDOW depends entirely on which model you've pulled —
# edit to match. GOOD_FOR is a comma list of task-type tags you assign
# yourself, not a benchmarked claim.
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_GOOD_FOR=general,coding
OLLAMA_COST_PER_1K_INPUT=0.0
OLLAMA_COST_PER_1K_OUTPUT=0.0

# OpenRouter: https://openrouter.ai/keys (no card needed for :free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT=60.0
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_RETRY_COUNT=1
OPENROUTER_CONTEXT_WINDOW=8192
OPENROUTER_GOOD_FOR=general
OPENROUTER_COST_PER_1K_INPUT=0.0
OPENROUTER_COST_PER_1K_OUTPUT=0.0

# Cloudflare Workers AI: https://dash.cloudflare.com -> Workers AI -> API tokens
# 10,000 free Neurons/day, no card needed. account_id is in your dashboard URL.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT=60.0
CLOUDFLARE_MAX_TOKENS=1024
CLOUDFLARE_TEMPERATURE=0.7
CLOUDFLARE_RETRY_COUNT=1
CLOUDFLARE_CONTEXT_WINDOW=4096
CLOUDFLARE_GOOD_FOR=general
CLOUDFLARE_COST_PER_1K_INPUT=0.0
CLOUDFLARE_COST_PER_1K_OUTPUT=0.0

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
